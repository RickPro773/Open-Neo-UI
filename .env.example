# ── Neotek AI Stack — variáveis de ambiente ──────────────────
# Copie este arquivo para .env e edite antes de subir
# cp .env.example .env

# Chave de API do gateway (clientes precisam enviar x-api-key: ESSE_VALOR)
API_KEY=neotek-local-dev

# Chave secreta do Open WebUI (qualquer string aleatória longa)
WEBUI_SECRET_KEY=mude-para-algo-aleatorio-aqui

# Senha do Postgres
POSTGRES_PASSWORD=neotek123

# Origens permitidas no CORS (use * para rede local, ou http://SEU_IP:3000)
ALLOWED_ORIGINS=*
