# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-this-to-something-random-min-32-chars

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/neo.db

# ── Email (Resend.com) ────────────────────────────────────────────────────────
# Get free API key at: https://resend.com
# Free tier: 3,000 emails/month, 100/day
# Leave blank to use dev mode (token shown in terminal instead of sent)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
APP_URL=http://localhost:3000


# Discord → https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# GitHub → https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Google → https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── AI Provider keys (users also add these via UI) ────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Tools ─────────────────────────────────────────────────────────────────────
WEB_SEARCH_MODE=auto
MAX_TOOL_CALLS=10
TOOL_TIMEOUT_MS=15000

# ── Python bridge (optional — for Gemini advanced + image) ───────────────────
PYTHON_BRIDGE_URL=http://localhost:8787
PYTHON_BRIDGE_SECRET=change-this-too

# ── GPU sharing ───────────────────────────────────────────────────────────────
GPU_MEMORY_LIMIT=85
